+
+const GRAPH_HYBRID_RRF_K: f64 = 60.0;
+
+#[derive(Clone, Copy, Debug, serde::Serialize)]
+pub struct FusionChannelWeights {
+    pub graph: f64,
+    pub hybrid: f64,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct FusionPolicy {
+    all_channels: bool,
+    weights: FusionChannelWeights,
+}
+
+impl Default for FusionPolicy {
+    fn default() -> Self {
+        Self {
+            all_channels: false,
+            weights: FusionChannelWeights {
+                graph: 1.0,
+                hybrid: 1.0,
+            },
+        }
+    }
+}
+
+impl FusionPolicy {
+    fn from_values(
+        enabled: Option<&str>,
+        graph: Option<&str>,
+        hybrid: Option<&str>,
+    ) -> Result<Self, MemoriaError> {
+        let all_channels = enabled.is_some_and(|value| {
+            matches!(
+                value.trim().to_ascii_lowercase().as_str(),
+                "true" | "1" | "yes"
+            )
+        });
+        if !all_channels {
+            return Ok(Self::default());
+        }
+        let weight = |value: Option<&str>| -> Result<f64, MemoriaError> {
+            let parsed = value.unwrap_or("1").trim().parse::<f64>().map_err(|_| {
+                MemoriaError::Validation("RRF channel weight must be positive and finite".into())
+            })?;
+            if !parsed.is_finite() || parsed <= 0.0 {
+                return Err(MemoriaError::Validation(
+                    "RRF channel weight must be positive and finite".into(),
+                ));
+            }
+            Ok(parsed)
+        };
+        Ok(Self {
+            all_channels,
+            weights: FusionChannelWeights {
+                graph: weight(graph)?,
+                hybrid: weight(hybrid)?,
+            },
+        })
+    }
+
+    fn from_env() -> Result<Self, MemoriaError> {
+        Self::from_values(
+            std::env::var("RRF_ALL_CHANNELS").ok().as_deref(),
+            std::env::var("RRF_GRAPH_WEIGHT").ok().as_deref(),
+            std::env::var("RRF_HYBRID_WEIGHT").ok().as_deref(),
+        )
+    }
+
+    fn graph_can_return(self, count: usize, top_k: usize) -> bool {
+        !self.all_channels && count >= top_k
+    }
+}
+
+/// Scores are comparable only within a channel; fuse the two unique ranked lists.
+fn fuse_graph_hybrid(
+    graph: Vec<Memory>,
+    hybrid: Vec<Memory>,
+    hybrid_scores: Vec<(String, f64, f64, f64, f64, f64)>,
+    top_k: usize,
+    policy: FusionPolicy,
+) -> (Vec<Memory>, Vec<CandidateScore>) {
+    fn ranked_unique(mut memories: Vec<Memory>, preserve_order: bool) -> Vec<Memory> {
+        // Experimental inputs are already ranked by their original channels.
+        // Preserve them exactly, including equal-score ties in a lone channel.
+        if !preserve_order {
+            memories.sort_by(|a, b| {
+                b.retrieval_score
+                    .filter(|s| s.is_finite())
+                    .partial_cmp(&a.retrieval_score.filter(|s| s.is_finite()))
+                    .unwrap_or(std::cmp::Ordering::Equal)
+                    .then_with(|| a.memory_id.cmp(&b.memory_id))
+            });
+        }
+        let mut seen = std::collections::HashSet::new();
+        memories.retain(|m| seen.insert(m.memory_id.clone()));
+        memories
+    }
+    let breakdown: HashMap<_, _> = hybrid_scores
+        .into_iter()
+        .map(|(id, vs, ks, ts, cs, _)| (id, (vs, ks, ts, cs)))
+        .collect();
+    let mut candidates: HashMap<String, (Memory, CandidateScore)> = HashMap::new();
+    for (is_graph, memories) in [(true, graph), (false, hybrid)] {
+        for (index, memory) in ranked_unique(memories, policy.all_channels)
+            .into_iter()
+            .enumerate()
+        {
+            let rank = index + 1;
+            let raw_score = memory.retrieval_score.filter(|s| s.is_finite());
+            let id = memory.memory_id.clone();
+            let (stored, score) = candidates.entry(id.clone()).or_insert_with(|| {
+                (
+                    memory.clone(),
+                    CandidateScore {
+                        memory_id: id,
+                        rank: 0,
+                        final_score: 0.0,
+                        vector_score: 0.0,
+                        keyword_score: 0.0,
+                        temporal_score: 0.0,
+                        confidence_score: 0.0,
+                        graph_rank: None,
+                        hybrid_rank: None,
+                        graph_score: None,
+                        hybrid_score: None,
+                    },
+                )
+            });
+            let weight = if is_graph {
+                policy.weights.graph
+            } else {
+                policy.weights.hybrid
+            };
+            score.final_score += weight / (GRAPH_HYBRID_RRF_K + rank as f64);
+            if is_graph {
+                score.graph_rank = Some(rank);
+                score.graph_score = raw_score;
+            } else {
+                *stored = memory;
+                score.hybrid_rank = Some(rank);
+                score.hybrid_score = raw_score;
+                if let Some(&(vs, ks, ts, cs)) = breakdown.get(&score.memory_id) {
+                    score.vector_score = round4(vs);
+                    score.keyword_score = round4(ks);
+                    score.temporal_score = round4(ts);
+                    score.confidence_score = round4(cs);
+                }
+            }
+        }
+    }
+    let mut ranked: Vec<_> = candidates.into_values().collect();
+    ranked.sort_by(|(_, a), (_, b)| {
+        b.final_score
+            .total_cmp(&a.final_score)
+            .then_with(|| a.memory_id.cmp(&b.memory_id))
+    });
+    ranked.truncate(top_k);
+    ranked
+        .into_iter()
+        .enumerate()
+        .map(|(index, (mut memory, mut score))| {
+            score.rank = index + 1;
+            memory.retrieval_score = Some(score.final_score);
+            (memory, score)
+        })
+        .unzip()
 }
 
